# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon key 또는 새 형식의 publishable key(sb_publishable_...) 둘 다 사용 가능
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# (선택) AI 제안 기능. 없으면 버튼이 숨겨집니다.
ANTHROPIC_API_KEY=
# (선택) 기본값 claude-opus-5-5. 비용을 낮추려면 claude-sonnet-5-5 또는 claude-haiku-5-5
ANTHROPIC_MODEL=
